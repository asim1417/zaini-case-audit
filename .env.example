ENGINE_MODE=tesseract

AZURE_DI_ENABLED=false
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
AZURE_DI_MODEL=prebuilt-read

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-read

# ─── الربط السحابي لجلب ملفات القضايا (service/cloud_drives.py) ───

# Google Drive — الخيار 1 (موصى به للخوادم): حساب خدمة
#   أنشئ حساب خدمة في Google Cloud وفعّل Drive API، ثم شارِك مجلد القضية
#   مع بريد حساب الخدمة (…@…iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_FILE=
# أو ألصق محتوى ملف JSON مباشرة (مناسب لـ Render/Docker secrets):
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Drive — الخيار 2: OAuth لحساب شخصي (Refresh Token)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# OneDrive / Microsoft Graph — تطبيق مسجّل في Azure/Entra ID
MS_CLIENT_ID=
# للمؤسسات (Client Credentials — يتطلب صلاحية تطبيق Files.Read.All بموافقة المسؤول):
MS_TENANT_ID=
MS_CLIENT_SECRET=
# صاحب مساحة OneDrive المستهدفة مع مصادقة المؤسسات (بريد المستخدم أو معرّف Drive):
MS_DRIVE_USER=
MS_DRIVE_ID=
# للحساب الشخصي/المفوّض: اترك TENANT/SECRET فارغين ونفّذ مرة واحدة:
#   python service/cloud_drives.py login-onedrive
ONEDRIVE_TOKEN_CACHE=
