# مثال إعداد البيئة — انسخه إلى .env واملأ القيم محلياً (لا تُرفع .env إطلاقاً)

# اختيار المحرّك: tesseract (افتراضي محلي) | azure | lift
ENGINE_MODE=tesseract

# تفعيل Azure بديلاً عن ENGINE_MODE (المفتاح وحده لا يُفعّل):
AZURE_DI_ENABLED=false

# بيانات Azure AI Document Intelligence (سحابي — تخرج البيانات لـMicrosoft عند التفعيل)
AZURE_DI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DI_KEY=__ضع-المفتاح-في-.env-المحلي-فقط__
AZURE_DI_MODEL=prebuilt-read

# مفتاح خدمة الـAPI (اختياري)
API_KEY=
